# Copy to .env.local and fill in. The public site runs with built-in seed content
# until the database is connected, so you can develop before these are set.

# Public site URL (used for canonical URLs, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://abscareer.com

# --- Hostinger MySQL (content + leads) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Admin panel login ---
# The shared password your staff use at /admin/login.
ADMIN_PASSWORD=
# A long random string used to sign the session cookie (keep secret).
ADMIN_SESSION_SECRET=

# --- Lead email notification (Hostinger SMTP) — optional but recommended ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_EMAIL=

# --- WhatsApp click-to-chat (country code + number, digits only) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=919702836946

# --- Google Analytics 4 (gtag.js) — site-wide measurement ID (G-XXXXXXXXXX) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-QBPH6GGB1S
